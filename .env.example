# ─── Copy to .env on the server and fill in. Never commit .env. ───
NODE_ENV=production
# Port reserved for this site on the server (also set in deploy/ecosystem.config.cjs and the Nginx upstream)
HOST=127.0.0.1
PORT=4380
# Behind Nginx: trust X-Forwarded-For for rate limiting / IP hashing
TRUST_PROXY=true
PUBLIC_SITE_URL=https://vapisvip.com

# MariaDB / MySQL (dedicated least-privilege user on the vvip_cms database)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=vvip_cms
DATABASE_PASSWORD=change-me
DATABASE_NAME=vvip_cms
DATABASE_POOL=10

# 64 hex characters: `openssl rand -hex 32`. Encrypts stored secrets and keys IP hashes.
# Changing it invalidates encrypted settings (re-enter the SMTP password in Settings).
APP_SECRET=

# Persistent uploads (git-ignored, so `git pull` deploys never touch it)
UPLOAD_DIR=/var/www/projects/vvip/VVIp-Website/storage/uploads

# Business time zone (admin timestamps, analytics day boundaries)
APP_TIMEZONE=Asia/Kolkata
APP_TZ_OFFSET=+05:30

# SMTP for inquiry notifications & password resets (takes precedence over Settings → Email)
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="VVIP Website <noreply@vapisvip.com>"
MAIL_TO=mail@vapisvip.com

# Optional: Google Search Console (service-account JSON key stored outside the web root)
GSC_SERVICE_ACCOUNT_FILE=
