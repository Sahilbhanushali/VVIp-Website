---
/**
 * Property gallery: category filters with animated (FLIP) reflow and a
 * full-screen lightbox (native <dialog>) with keyboard, swipe and
 * counter. Only real NeoVista imagery is used.
 */
import { Image, getImage } from 'astro:assets';
import SplitText from './SplitText.astro';
import Icon from './Icon.astro';
import { gallery, galleryCategories } from '../data/site';

interface Props {
  id?: string;
  tone?: 'light' | 'dark';
}
const { id = 'gallery', tone = 'light' } = Astro.props;

const items = await Promise.all(
  gallery.map(async (g) => {
    const full = await getImage({ src: g.image, width: Math.min(1920, g.image.width), format: 'webp', quality: 78 });
    return { ...g, full: full.src };
  }),
);
---

<section id={id} class:list={['section', tone === 'dark' ? 'section--ink' : 'section--light', 'gallery']} aria-labelledby={`${id}-title`} data-gallery>
  <div class="container">
    <header class="section-head section-head--split">
      <div class="section-head__title">
        <p class="eyebrow" data-reveal>Gallery</p>
        <SplitText id={`${id}-title`} class="h-section" text="Inside the *VIP era*" />
      </div>
      <div class="gallery__intro">
        <p class="lead" data-reveal style="--d:2">
          From grand valet arrivals and gallery inspired foyers to designer offices — explore NeoVista in pictures.
        </p>
        <div class="gallery__filters" role="group" aria-label="Filter gallery" data-reveal style="--d:3">
          <button type="button" class="chip" aria-pressed="true" data-filter="all">All <span>{items.length}</span></button>
          {galleryCategories.map((c) => (
            <button type="button" class="chip" aria-pressed="false" data-filter={c}>
              {c} <span>{items.filter((i) => i.category === c).length}</span>
            </button>
          ))}
        </div>
      </div>
    </header>

    <ul class="gallery__grid" role="list" data-grid>
      {items.map((item, i) => (
        <li class:list={['gallery__item', `is-${item.shape}`]} data-category={item.category} data-index={i}>
          <button
            type="button"
            class="gallery__open"
            data-full={item.full}
            data-title={item.title}
            data-category-label={item.category}
            aria-label={`Open image: ${item.title}`}
          >
            <Image
              src={item.image}
              alt={item.title}
              widths={[360, 540, 720, 960]}
              sizes={item.shape === 'wide' ? '(min-width: 1100px) 680px, (min-width: 640px) 66vw, 100vw' : '(min-width: 1100px) 340px, (min-width: 640px) 33vw, 50vw'}
              quality={68}
              format="webp"
              loading="lazy"
              decoding="async"
            />
            <span class="gallery__caption">
              <span class="gallery__cat">{item.category}</span>
              <span class="gallery__title">{item.title}</span>
            </span>
            <span class="gallery__zoom" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="lightbox" aria-label="Image viewer" data-lightbox>
    <div class="lightbox__top">
      <p class="lightbox__count"><span data-lb-index>1</span> / <span data-lb-total>{items.length}</span></p>
      <button type="button" class="lightbox__btn" data-lb-close aria-label="Close viewer"><Icon name="close" size={22} /></button>
    </div>
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" data-lb-img decoding="async" />
      <figcaption class="lightbox__caption">
        <span class="gallery__cat" data-lb-cat></span>
        <span data-lb-title></span>
      </figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Previous image"><Icon name="arrow-left" size={22} /></button>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--next" data-lb-next aria-label="Next image"><Icon name="arrow-right" size={22} /></button>
  </dialog>
</section>

<style>
  .gallery__intro { display: grid; gap: 1.5rem; }
  .gallery__filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(13, 13, 12, 0.15);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
    transition: background-color 350ms ease, color 350ms ease, border-color 350ms ease;
  }
  .chip span { font-size: 0.7rem; color: var(--body-color); transition: color 350ms ease; }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--white); }
  .chip[aria-pressed='true'] span { color: var(--bronze-light); }
  .section--ink .chip { color: var(--white); border-color: var(--line-dark); }
  .section--ink .chip[aria-pressed='true'] { background: var(--bronze); border-color: var(--bronze); color: var(--ink); }
  .section--ink .chip[aria-pressed='true'] span { color: var(--ink); }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: clamp(150px, 38vw, 230px);
    grid-auto-flow: dense;
    gap: clamp(0.5rem, 0.3rem + 0.8vw, 1rem);
  }
  @media (min-width: 640px) {
    .gallery__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: clamp(180px, 20vw, 260px); }
  }
  @media (min-width: 1100px) {
    .gallery__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(200px, 15vw, 250px); }
  }
  .gallery__item.is-wide { grid-column: span 2; }
  .gallery__item.is-tall { grid-row: span 2; }
  .gallery__item[hidden] { display: none; }
  .gallery__open {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--charcoal);
    cursor: zoom-in;
    isolation: isolate;
  }
  .gallery__open :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1200ms var(--ease-out), filter 600ms ease;
  }
  .gallery__open::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(13, 13, 12, 0.85));
    opacity: 0;
    transition: opacity 500ms ease;
  }
  .gallery__caption {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.9rem;
    z-index: 1;
    display: grid;
    gap: 0.2rem;
    text-align: left;
    color: var(--white);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 500ms ease, transform 600ms var(--ease-out);
  }
  .gallery__cat {
    font-family: var(--ff-title);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bronze-light);
  }
  .gallery__title { font-family: var(--ff-title); font-size: 0.95rem; font-weight: 500; }
  .gallery__zoom {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    transform: scale(0.6);
    opacity: 0;
    transition: transform 500ms var(--ease-out), opacity 400ms ease;
  }
  .gallery__open:hover :global(img), .gallery__open:focus-visible :global(img) { transform: scale(1.06); }
  .gallery__open:hover::after, .gallery__open:focus-visible::after,
  .gallery__open:hover .gallery__caption, .gallery__open:focus-visible .gallery__caption,
  .gallery__open:hover .gallery__zoom, .gallery__open:focus-visible .gallery__zoom { opacity: 1; transform: none; }
  @media (hover: none) {
    .gallery__open::after, .gallery__caption { opacity: 1; transform: none; }
    .gallery__title { font-size: 0.82rem; }
  }

  /* Lightbox */
  .lightbox {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(8, 8, 7, 0.96);
    color: var(--white);
    overflow: hidden;
  }
  .lightbox::backdrop { background: rgba(8, 8, 7, 0.9); }
  .lightbox[open] { display: grid; grid-template-rows: auto 1fr; }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] { animation: lb-in 450ms ease both; }
  }
  @keyframes lb-in { from { opacity: 0; } }
  .lightbox__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem var(--gutter);
  }
  .lightbox__count { font-family: var(--ff-title); font-size: 0.8rem; letter-spacing: 0.14em; color: rgba(255, 255, 255, 0.7); }
  .lightbox__figure {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
    min-height: 0;
    padding: 0 var(--gutter) 1.5rem;
    touch-action: pan-y;
  }
  .lightbox__img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    border-radius: var(--radius);
    transition: opacity 300ms ease, transform 500ms var(--ease-out);
  }
  .lightbox__img.is-loading { opacity: 0; transform: scale(0.985); }
  .lightbox__caption { display: grid; justify-items: center; gap: 0.25rem; text-align: center; font-family: var(--ff-title); }
  .lightbox__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--white);
    background: rgba(13, 13, 12, 0.5);
    transition: background-color 300ms ease, color 300ms ease, border-color 300ms ease;
  }
  .lightbox__btn:hover { background: var(--bronze); border-color: var(--bronze); color: var(--ink); }
  .lightbox__nav { position: absolute; top: 50%; transform: translateY(-50%); }
  .lightbox__nav--prev { left: clamp(0.5rem, 2vw, 2rem); }
  .lightbox__nav--next { right: clamp(0.5rem, 2vw, 2rem); }
  @media (max-width: 639px) {
    .lightbox__nav { top: auto; bottom: 1rem; transform: none; }
    .lightbox__figure { padding-bottom: 5rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const items = Array.from(grid.querySelectorAll<HTMLElement>('li'));
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));

    /* ---- Filtering with FLIP animation ---- */
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter!;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        const first = new Map(items.map((el) => [el, el.getBoundingClientRect()]));
        items.forEach((el) => (el.hidden = filter !== 'all' && el.dataset.category !== filter));
        if (reduced) return;
        items.forEach((el) => {
          if (el.hidden) return;
          const a = first.get(el)!;
          const b = el.getBoundingClientRect();
          if (a.width === 0) {
            el.animate([{ opacity: 0, transform: 'scale(0.92)' }, { opacity: 1, transform: 'none' }], {
              duration: 550, easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
            });
          } else {
            el.animate(
              [
                { transform: `translate(${a.left - b.left}px, ${a.top - b.top}px) scale(${a.width / b.width}, ${a.height / b.height})` },
                { transform: 'none' },
              ],
              { duration: 650, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
            );
          }
        });
      }),
    );

    /* ---- Lightbox ---- */
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const title = dialog.querySelector<HTMLElement>('[data-lb-title]')!;
    const cat = dialog.querySelector<HTMLElement>('[data-lb-cat]')!;
    const idx = dialog.querySelector<HTMLElement>('[data-lb-index]')!;
    const total = dialog.querySelector<HTMLElement>('[data-lb-total]')!;
    let list: HTMLButtonElement[] = [];
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + list.length) % list.length;
      const btn = list[current];
      img.classList.add('is-loading');
      const next = new Image();
      next.src = btn.dataset.full!;
      next.decode().catch(() => {}).finally(() => {
        img.src = next.src;
        img.alt = btn.dataset.title ?? '';
        img.classList.remove('is-loading');
      });
      title.textContent = btn.dataset.title ?? '';
      cat.textContent = btn.dataset.categoryLabel ?? '';
      idx.textContent = String(current + 1);
      total.textContent = String(list.length);
      // Preload the neighbour for instant next navigation
      const n = list[(current + 1) % list.length];
      if (n) new Image().src = n.dataset.full!;
    };

    grid.querySelectorAll<HTMLButtonElement>('.gallery__open').forEach((btn) =>
      btn.addEventListener('click', () => {
        list = items.filter((el) => !el.hidden).map((el) => el.querySelector<HTMLButtonElement>('.gallery__open')!);
        opener = btn;
        dialog.showModal();
        document.body.style.overflow = 'hidden';
        show(list.indexOf(btn));
      }),
    );
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      opener?.focus({ preventScroll: true });
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });
    let sx = 0;
    dialog.addEventListener('pointerdown', (e) => (sx = e.clientX));
    dialog.addEventListener('pointerup', (e) => {
      const dx = e.clientX - sx;
      if (Math.abs(dx) > 50 && e.target === img) show(current + (dx < 0 ? 1 : -1));
    });
  });
</script>
