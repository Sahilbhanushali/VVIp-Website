---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import type { SiteContext } from '../server/site.ts';

interface Props {
  isHome?: boolean;
  ctx: SiteContext;
}
const { isHome = false, ctx } = Astro.props;
const { settings } = ctx;
const { contact, footer } = settings;
const href = (h: string) => (isHome && h.startsWith('/#') ? h.slice(1) : h);
// Always the current year at render time (pages are re-rendered, never frozen at build time).
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__cta">
      <p class="footer__statement" data-reveal>
        {footer.statement}{footer.statement_highlight && <>{' '}<em>{footer.statement_highlight}</em></>}
      </p>
      {settings.header.cta_enabled && (
        <a href={href('/#contact-sec')} class="btn" data-open-visit data-reveal style="--d:2">
          {settings.header.cta_label} <Icon name="arrow-right" />
        </a>
      )}
    </div>

    <div class="footer__grid">
      <div class="footer__brand">
        <a href={isHome ? '#hero' : '/'} aria-label={`${settings.site.name} — home`}><Logo media={ctx.logo} height={48} /></a>
        {footer.about && <p>{footer.about}</p>}
        <ul class="footer__social" role="list">
          {settings.social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${s.name} (opens in a new tab)`}>
                <Icon name={s.icon} size={18} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav class="footer__col" aria-label="Footer">
        <h2 class="footer__title">Explore</h2>
        <ul role="list">
          {ctx.footer.map((item) => (
            <li><a href={href(item.url)} target={item.new_tab ? '_blank' : undefined} rel={item.new_tab ? 'noopener' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer__col">
        <h2 class="footer__title">Get in touch</h2>
        <ul role="list" class="footer__contact">
          {contact.address && <li><Icon name="pin" size={18} /><span>{contact.address}</span></li>}
          {contact.phones.length > 0 && (
            <li>
              <Icon name="phone" size={18} />
              <span>{contact.phones.map((p) => <a href={p.href}>{p.label}</a>)}</span>
            </li>
          )}
          {contact.whatsapp && (
            <li>
              <Icon name="whatsapp" size={18} />
              <span><a href={`https://wa.me/${contact.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer">WhatsApp {contact.whatsapp}</a></span>
            </li>
          )}
          {contact.emails.length > 0 && (
            <li>
              <Icon name="mail" size={18} />
              <span>{contact.emails.map((e) => <a href={e.href}>{e.label}</a>)}</span>
            </li>
          )}
        </ul>
      </div>

      {contact.hours.length > 0 && (
        <div class="footer__col">
          <h2 class="footer__title">Office hours</h2>
          <ul role="list" class="footer__hours">
            {contact.hours.map((h) => (
              <li><span>{h.days}</span><span>{h.time}</span></li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="footer__bottom">
      <p>
        Copyright © {year} <a href={isHome ? '#hero' : '/'}>{footer.copyright_name}</a>, All rights reserved{footer.credit && ` By ${footer.credit}`}
      </p>
      {ctx.legal.length > 0 && (
        <ul class="footer__legal" role="list">
          {ctx.legal.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
        </ul>
      )}
      <a href="#top" class="footer__top" data-scroll-top>
        Back to top <Icon name="arrow-up" size={16} />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--ink);
    color: var(--on-dark-muted);
    padding-top: clamp(4.5rem, 3rem + 6vw, 8rem);
    overflow: hidden;
  }
  .footer::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: min(1200px, 120%);
    aspect-ratio: 2;
    transform: translate(-50%, -55%);
    background: radial-gradient(closest-side, rgba(191, 120, 64, 0.16), transparent);
    pointer-events: none;
  }
  .footer__cta {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: end;
    padding-bottom: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    border-bottom: 1px solid var(--line-dark);
  }
  @media (min-width: 992px) { .footer__cta { grid-template-columns: 1fr auto; gap: 5rem; } }
  .footer__statement {
    font-family: var(--ff-title);
    font-size: clamp(1.6rem, 1.1rem + 2.2vw, 3.1rem);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--white);
    max-width: 24ch;
  }
  .footer__statement em {
    font-style: normal;
    font-weight: 500;
    background: var(--bronze-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .footer__grid {
    display: grid;
    gap: 3rem 2.5rem;
    padding-block: clamp(3.5rem, 2.5rem + 3vw, 5rem);
  }
  @media (min-width: 640px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .footer__grid { grid-template-columns: 1.5fr 0.7fr 1.2fr 0.9fr; gap: 4rem; } }
  .footer__brand { display: grid; gap: 1.5rem; align-content: start; }
  .footer__brand img { height: 48px; width: auto; }
  .footer__brand p { max-width: 40ch; font-size: 0.95rem; }
  .footer__social { display: flex; gap: 0.75rem; }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-dark);
    color: var(--white);
    transition: background-color 400ms ease, border-color 400ms ease, color 400ms ease, transform 400ms var(--ease-out);
  }
  .footer__social a:hover { background: var(--bronze); border-color: var(--bronze); color: var(--ink); transform: translateY(-3px); }
  .footer__title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--white);
    margin-bottom: 1.5rem;
  }
  .footer__col ul { display: grid; gap: 0.85rem; font-size: 0.95rem; }
  .footer__col a { transition: color 300ms ease; }
  .footer__col a:hover { color: var(--bronze-light); }
  .footer__contact li { display: grid; grid-template-columns: 18px 1fr; gap: 0.9rem; align-items: start; }
  .footer__contact svg { color: var(--bronze); margin-top: 0.3rem; }
  .footer__contact span { display: grid; gap: 0.2rem; overflow-wrap: anywhere; }
  .footer__hours li { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--line-dark); padding-bottom: 0.85rem; }
  .footer__hours li span:last-child { color: var(--white); }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.75rem 2rem;
    border-top: 1px solid var(--line-dark);
    font-size: 0.85rem;
  }
  .footer__bottom a:hover { color: var(--bronze-light); }
  .footer__legal { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .footer__legal a { color: var(--on-dark-muted); transition: color 300ms ease; }
  .footer__legal a:hover { color: var(--bronze-light); }
  .footer__top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--ff-title);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--white);
  }
</style>
