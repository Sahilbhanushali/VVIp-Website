---
import { Image } from 'astro:assets';
import SplitText from '../SplitText.astro';
import Icon from '../Icon.astro';
import facade from '../../assets/images/neovista-facade.jpg';
---

<section id="about-sec" class="section section--light about" aria-labelledby="about-title">
  <div class="container">
    <header class="section-head section-head--split">
      <div class="about__title">
        <p class="eyebrow" data-reveal>About NeoVista</p>
        <SplitText id="about-title" class="h-section" text="Two Towers. One Vision. *Infinite Impact.*" />
      </div>
      <p class="lead" data-reveal style="--d:2">
        Every landmark has a purpose. VAPI’S VIP is a transformative vision that unites business, healthcare,
        hospitality and lifestyle under one iconic address. Rising proudly above the city, its twin towers redefine what
        it means to build for the future.
      </p>
    </header>

    <div class="about__compose">
      <figure class="about__figure">
        <div class="frame about__frame" data-reveal="clip" data-parallax style="--parallax:5">
          <Image
            src={facade}
            format="webp"
            widths={[640, 960, 1280, 1600, 1920]}
            sizes="(min-width: 1100px) 980px, 100vw"
            quality={70}
            alt="NeoVista façade with twin towers and landscaped podium"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="about__caption">
          <span>NeoVista</span>
          <span>Char Rasta · Vapi · Gujarat</span>
        </figcaption>
      </figure>

      <div class="about__card" data-reveal style="--d:2">
        <p class="about__kicker">By Odhav Developers — building South Gujarat since 1999.</p>
        <p>
          In today’s real estate market, where options are endless but reliability is rare, Odhav Developers has quietly
          and consistently earned its place as a trusted name.
        </p>
        <p>
          With over 26 years of experience in South Gujarat, our journey hasn’t been about flashy promises, it’s been
          about doing the right things, one project at a time.
        </p>
        <a href="/blog-details.html" class="link-arrow">A real commitment <Icon name="arrow-right" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .about__title { display: grid; gap: var(--stack); }
  .about__title :global(h2) { max-width: 14ch; }
  .about__compose { display: grid; }
  .about__frame { aspect-ratio: 4 / 3; border-radius: var(--radius-lg); }
  .about__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    font-family: var(--ff-title);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--body-color);
  }
  .about__card {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin: -3rem 0.75rem 0;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    background: var(--ink);
    color: var(--on-dark-muted);
    border-radius: var(--radius-lg);
    box-shadow: 0 40px 80px -40px rgba(13, 13, 12, 0.6);
  }
  .about__kicker {
    font-family: var(--ff-title);
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.55rem);
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--white);
  }
  @media (min-width: 768px) {
    .about__frame { aspect-ratio: 16 / 9; }
  }
  @media (min-width: 1100px) {
    .about__compose { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: end; }
    .about__figure { grid-column: 1 / 10; grid-row: 1; }
    .about__frame { aspect-ratio: 16 / 10; }
    .about__card { grid-column: 8 / 13; grid-row: 1; margin: 0 0 4.5rem; }
  }
</style>
