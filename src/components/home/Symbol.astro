---
import { Image } from 'astro:assets';
import SplitText from '../SplitText.astro';
import Icon from '../Icon.astro';
import banner from '../../assets/images/brand/neovista-banner.jpg';
---

<section class="section symbol" aria-labelledby="symbol-title">
  <div class="container symbol__grid">
    <div class="symbol__art" data-reveal="clip">
      <Image
        src={banner}
        alt="NeoVista — Crafted with business sense"
        widths={[480, 720, 960, 1350]}
        sizes="(min-width: 992px) 600px, calc(100vw - 2rem)"
        quality={78}
        format="webp"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="symbol__text">
      <p class="eyebrow" data-reveal>Crafted with business sense</p>
      <SplitText id="symbol-title" class="h-section" text="NeoVista is a Symbol of *Success*" />
      <p class="lead" data-reveal style="--d:2">
        A visionary twin tower marvel, it redefines the city’s business landscape with an unmistakable aura of luxury.
        Strategically located in the heart of Vapi, it rises with purpose, offering a seamless blend of architectural
        excellence, thoughtful planning, and elite amenities.
      </p>
      <p data-reveal style="--d:3">
        From grand valet arrivals and gallery inspired foyers to designer offices and a dedicated Hospitality tower,
        every detail is curated for those who demand more.
      </p>
      <div class="symbol__actions" data-reveal style="--d:4">
        <a href="#contact-sec" class="btn" data-open-visit>Schedule a visit <Icon name="arrow-right" /></a>
        <a href="#property-sec" class="link-arrow">View features <Icon name="arrow-right" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .symbol {
    background: #000;
    color: var(--on-dark-muted);
    overflow: hidden;
  }
  .symbol::before {
    content: '';
    position: absolute;
    right: -20%;
    top: 10%;
    width: 70vw;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(191, 120, 64, 0.14), transparent);
    pointer-events: none;
  }
  .symbol :global(h2) { color: var(--white); max-width: 12ch; }
  .symbol__grid {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 5vw, 6rem);
    align-items: center;
  }
  @media (min-width: 992px) { .symbol__grid { grid-template-columns: 1fr 1fr; } }
  .symbol__art {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    aspect-ratio: 1350 / 1255;
  }
  .symbol__art :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .symbol__text { display: grid; gap: 1.5rem; }
  .symbol__text .lead { color: var(--on-dark); }
  .symbol__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem 2rem; margin-top: 0.75rem; }
</style>
