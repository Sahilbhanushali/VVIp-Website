---
/**
 * Tower explorer — accessible tabs (roving focus, arrow keys) that swap a
 * large image stage with a clip-path wipe and an information panel.
 */
import { Image } from 'astro:assets';
import SplitText from '../SplitText.astro';
import Icon from '../Icon.astro';
import { towerViews } from '../../data/site';

interface Props {
  id?: string;
  linkToDetails?: boolean;
}
const { id = 'service-sec', linkToDetails = true } = Astro.props;
---

<section id={id} class="section section--ink towers" aria-labelledby={`${id}-title`} data-towers>
  <div class="container">
    <header class="section-head section-head--split">
      <div class="section-head__title">
        <p class="eyebrow" data-reveal>The Towers</p>
        <SplitText id={`${id}-title`} class="h-section" text="Where the extraordinary *do business.*" />
      </div>
      <p class="lead" data-reveal style="--d:2">
        This isn’t just an address, it’s an experience for those who lead, inspire, and redefine success. From the grand
        arrival to every flawless detail, VVIP is more than a title, it’s a feeling.
      </p>
    </header>

    <div class="towers__grid">
      <div class="towers__tabs" role="tablist" aria-label="NeoVista towers" data-reveal>
        {towerViews.map((t, i) => (
          <button
            class="towers__tab"
            role="tab"
            type="button"
            id={`${id}-tab-${i}`}
            aria-controls={`${id}-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={i}
          >
            <span class="towers__code" aria-hidden="true">{t.code}</span>
            <span class="towers__tab-text">
              <span class="towers__kicker">0{i + 1} · {t.kicker}</span>
              <span class="towers__tab-title">{t.title}</span>
            </span>
            <span class="towers__tab-bar" aria-hidden="true"></span>
          </button>
        ))}
      </div>

      <div class="towers__stage" data-reveal="clip">
        {towerViews.map((t, i) => (
          <div class:list={['towers__shot', i === 0 && 'is-active']} data-shot={i}>
            <Image
              src={t.image}
              alt=""
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 1100px) 780px, calc(100vw - 2.25rem)"
              quality={70}
              format="webp"
              loading="lazy"
              decoding="async"
              style={`object-position:${t.position}`}
            />
          </div>
        ))}
        {towerViews.map((t, i) => (
          <div
            class="towers__panel"
            role="tabpanel"
            id={`${id}-panel-${i}`}
            aria-labelledby={`${id}-tab-${i}`}
            hidden={i !== 0}
            data-panel={i}
          >
            <h3 class="towers__panel-title">{t.title}</h3>
            <p>{t.text}</p>
            <ul class="towers__tags" role="list">
              {t.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>

    {linkToDetails && (
      <div class="towers__cta" data-reveal>
        <a href="/neovista.html" class="link-arrow">Explore the full property <Icon name="arrow-right" /></a>
      </div>
    )}
  </div>
</section>

<style>
  .towers__grid {
    display: grid;
    gap: var(--grid-gap);
  }
  @media (min-width: 1100px) {
    .towers__grid { grid-template-columns: 0.75fr 1.25fr; gap: clamp(2rem, 4vw, 4rem); align-items: stretch; }
  }

  /* Tabs */
  .towers__tabs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(15rem, 1fr);
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }
  .towers__tabs::-webkit-scrollbar { display: none; }
  @media (min-width: 1100px) {
    .towers__tabs {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      align-content: center;
      gap: 0;
      margin: 0;
      padding: 0;
      overflow: visible;
      border-top: 1px solid var(--line-dark);
    }
  }
  .towers__tab {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: center;
    padding: 1.25rem;
    text-align: left;
    color: var(--on-dark-muted);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-lg);
    scroll-snap-align: start;
    transition: color 400ms ease, background-color 400ms ease, border-color 400ms ease;
  }
  @media (min-width: 1100px) {
    .towers__tab {
      padding: 1.75rem 0;
      border: 0;
      border-bottom: 1px solid var(--line-dark);
      border-radius: 0;
    }
  }
  .towers__tab:hover { color: var(--white); }
  .towers__tab[aria-selected='true'] { color: var(--white); border-color: rgba(191, 120, 64, 0.5); }
  @media (max-width: 1099px) {
    .towers__tab[aria-selected='true'] { background: rgba(191, 120, 64, 0.08); }
  }
  .towers__code {
    font-family: var(--ff-title);
    font-size: clamp(2.5rem, 2rem + 2vw, 3.75rem);
    font-weight: 200;
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 1px rgba(191, 120, 64, 0.65);
    transition: color 500ms var(--ease-out);
    width: 1.1em;
  }
  .towers__tab[aria-selected='true'] .towers__code { color: var(--bronze); -webkit-text-stroke-color: var(--bronze); }
  .towers__tab-text { display: grid; gap: 0.35rem; }
  .towers__kicker {
    font-family: var(--ff-title);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bronze);
  }
  .towers__tab-title {
    font-family: var(--ff-title);
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.35rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .towers__tab-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--bronze-gradient);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 800ms var(--ease-out);
  }
  @media (min-width: 1100px) {
    .towers__tab[aria-selected='true'] .towers__tab-bar { transform: scaleX(1); }
  }

  /* Stage */
  .towers__stage {
    position: relative;
    display: grid;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--charcoal);
  }
  .towers__shot {
    grid-area: 1 / 1;
    aspect-ratio: 4 / 3;
    position: relative;
    overflow: hidden;
    clip-path: inset(0 0 0 100%);
    transition: clip-path 1000ms var(--ease-in-out);
  }
  .towers__shot.is-active { clip-path: inset(0 0 0 0); z-index: 1; }
  .towers__shot.was-active { clip-path: inset(0 0 0 0); }
  .towers__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 1600ms var(--ease-out);
  }
  .towers__shot.is-active :global(img) { transform: scale(1); }
  @media (min-width: 1100px) {
    .towers__shot { aspect-ratio: 16 / 11; }
  }

  .towers__panel {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.85rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    background: var(--charcoal);
    color: var(--on-dark-muted);
  }
  @media (min-width: 768px) {
    .towers__panel {
      position: absolute;
      left: 1.25rem;
      right: auto;
      bottom: 1.25rem;
      max-width: 30rem;
      border-radius: var(--radius-lg);
      background: rgba(13, 13, 12, 0.72);
      backdrop-filter: blur(16px) saturate(1.2);
      -webkit-backdrop-filter: blur(16px) saturate(1.2);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
  }
  .towers__panel[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .towers__panel:not([hidden]) { animation: panel-in 700ms var(--ease-out) both; }
  }
  @keyframes panel-in { from { opacity: 0; transform: translateY(14px); } }
  .towers__panel-title { font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.55rem); font-weight: 400; color: var(--white); }
  .towers__panel p { font-size: 0.95rem; }
  .towers__tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .towers__tags li {
    padding: 0.35rem 0.8rem;
    border: 1px solid rgba(252, 194, 128, 0.3);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--bronze-light);
  }
  .towers__cta { margin-top: var(--section-head-gap); display: flex; justify-content: flex-end; }

  @media (prefers-reduced-motion: reduce) {
    .towers__shot, .towers__shot :global(img) { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-towers]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const shots = Array.from(root.querySelectorAll<HTMLElement>('[data-shot]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    let active = 0;

    const select = (i: number, focus = false) => {
      if (i === active) return;
      tabs.forEach((t, n) => {
        t.setAttribute('aria-selected', String(n === i));
        t.tabIndex = n === i ? 0 : -1;
      });
      shots.forEach((s, n) => {
        s.classList.toggle('was-active', n === active);
        s.classList.toggle('is-active', n === i);
      });
      panels.forEach((p, n) => (p.hidden = n !== i));
      active = i;
      if (focus) tabs[i].focus();
      // On small screens the tab list scrolls horizontally: keep the active tab in view.
      const list = tabs[i].parentElement!;
      if (list.scrollWidth > list.clientWidth) {
        list.scrollTo({ left: tabs[i].offsetLeft - list.offsetLeft - 16, behavior: 'smooth' });
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = {
          ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1,
        };
        if (e.key in keys) {
          e.preventDefault();
          select((active + keys[e.key] + tabs.length) % tabs.length, true);
        } else if (e.key === 'Home') {
          e.preventDefault();
          select(0, true);
        } else if (e.key === 'End') {
          e.preventDefault();
          select(tabs.length - 1, true);
        }
      });
    });
  });
</script>
