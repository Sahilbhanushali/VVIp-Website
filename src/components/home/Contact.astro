---
import SplitText from '../SplitText.astro';
import ContactForm from '../ContactForm.astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';

interface Props { showMap?: boolean }
const { showMap = true } = Astro.props;
---

<section id="contact-sec" class="section section--dark contact" aria-labelledby="contact-title">
  <!-- Legacy anchor kept for old links (#contact-sec1) -->
  <span id="contact-sec1" class="contact__anchor" aria-hidden="true"></span>

  <div class="container contact__grid">
    <div class="contact__info">
      <p class="eyebrow" data-reveal>Contact Us</p>
      <SplitText id="contact-title" class="h-section" text="Schedule a *visit*" />
      <p class="lead" data-reveal style="--d:2">
        As a Vapi’s VIP, you’re not just securing a space, you’re unlocking a world of distinction. Visit NeoVista or
        reach our team directly.
      </p>

      <ul class="contact__list" role="list">
        <li data-reveal style="--d:3">
          <span class="contact__icon"><Icon name="pin" /></span>
          <div>
            <p class="contact__label">Address</p>
            <p class="contact__value">{site.address}</p>
            <a class="link-arrow contact__dir" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
              Get directions <Icon name="external" size={14} />
            </a>
          </div>
        </li>
        <li data-reveal style="--d:4">
          <span class="contact__icon"><Icon name="phone" /></span>
          <div>
            <p class="contact__label">Phone</p>
            {site.phones.map((p) => <a class="contact__value" href={p.href}>{p.label}</a>)}
          </div>
        </li>
        <li data-reveal style="--d:5">
          <span class="contact__icon"><Icon name="mail" /></span>
          <div>
            <p class="contact__label">Email</p>
            {site.emails.map((e) => <a class="contact__value" href={e.href}>{e.label}</a>)}
          </div>
        </li>
        <li data-reveal style="--d:6">
          <span class="contact__icon"><Icon name="clock" /></span>
          <div>
            <p class="contact__label">Office hours</p>
            {site.hours.map((h) => <p class="contact__value">{h.days} · {h.time}</p>)}
          </div>
        </li>
      </ul>
    </div>

    <div class="contact__card" data-reveal style="--d:2">
      <h3 class="contact__card-title">Send us a message</h3>
      <ContactForm idPrefix="contact" tone="light" />
    </div>
  </div>

  {showMap && <div class="contact__map container" data-reveal>
    <iframe
      title="Map showing NeoVista, Char Rasta, Vapi"
      src={site.mapEmbed}
      width="1320"
      height="460"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen></iframe>
  </div>}
</section>

<style>
  .contact { padding-bottom: clamp(3rem, 2rem + 4vw, 6rem); }
  .contact__anchor { position: absolute; top: 0; }
  .contact__grid {
    display: grid;
    gap: clamp(3rem, 5vw, 6rem);
    align-items: start;
  }
  @media (min-width: 992px) { .contact__grid { grid-template-columns: 0.9fr 1.1fr; } }
  .contact__info { display: grid; gap: 1.5rem; }
  .contact__list { display: grid; gap: 1.75rem; margin-top: 1.5rem; }
  .contact__list li { display: grid; grid-template-columns: 48px 1fr; gap: 1.25rem; align-items: start; }
  .contact__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(191, 120, 64, 0.45);
    color: var(--bronze-light);
  }
  .contact__label {
    font-family: var(--ff-title);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 0.35rem;
  }
  .contact__value { display: block; color: var(--on-dark); overflow-wrap: anywhere; line-height: 1.6; }
  a.contact__value { transition: color 300ms ease; width: fit-content; }
  a.contact__value:hover { color: var(--bronze-light); }
  .contact__dir { margin-top: 0.6rem; }

  .contact__card {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 1rem + 3vw, 3.25rem);
    box-shadow: 0 50px 100px -40px rgba(0, 0, 0, 0.7);
  }
  .contact__card-title {
    color: var(--ink);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem);
    font-weight: 300;
    margin-bottom: 1rem;
  }

  .contact__map { margin-top: clamp(3.5rem, 2.5rem + 4vw, 6rem); }
  .contact__map iframe {
    width: 100%;
    height: clamp(320px, 40vw, 460px);
    border: 0;
    border-radius: var(--radius-lg);
    filter: grayscale(0.85) contrast(1.05) brightness(0.92);
    transition: filter 800ms ease;
    background: var(--charcoal-2);
  }
  .contact__map iframe:hover, .contact__map iframe:focus { filter: none; }
</style>
