---
import SplitText from '../SplitText.astro';
import BlogCard from '../BlogCard.astro';
import { getPosts } from '../../utils/blog';

const [first, ...rest] = await getPosts();
---

<section id="blog-sec" class="section section--light insights" aria-labelledby="insights-title">
  <div class="container">
    <header class="section-head section-head--split">
      <div class="insights__head">
        <p class="eyebrow" data-reveal>Blogs</p>
        <SplitText id="insights-title" class="h-section" text="Notes on Vapi’s *rising skyline*" />
      </div>
      <p class="lead" data-reveal style="--d:2">
        Perspectives from Odhav Developers on Vapi’s commercial growth, Char Rasta’s transformation and what it takes to
        build an address worth saying yes to.
      </p>
    </header>

    {first && <BlogCard post={first} variant="feature" />}
    <div class="insights__grid">
      {rest.map((post, i) => <BlogCard post={post} delay={i} />)}
    </div>
  </div>
</section>

<style>
  .insights__head { display: grid; gap: 1.5rem; }
  .insights__head :global(h2) { max-width: 13ch; }
  .insights__grid {
    display: grid;
    gap: 3.5rem 2.5rem;
    margin-top: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    padding-top: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 768px) { .insights__grid { grid-template-columns: 1fr 1fr; } }
</style>
