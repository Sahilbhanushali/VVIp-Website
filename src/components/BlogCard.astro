<style>
  .card {
    position: relative;
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .card__media {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1400ms var(--ease-out);
  }
  .card:hover .card__media :global(img) { transform: scale(1.06); }
  .card__body { display: grid; gap: 0.9rem; }
  .card__meta {
    display: flex;
    gap: 0.6rem;
    font-family: var(--ff-title);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--body-color);
  }
  .card__title {
    overflow-wrap: break-word;
    hyphens: auto;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .card__title a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 600ms var(--ease-out);
  }
  /* The whole card is clickable via the title link */
  .card__title a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .card:hover .card__title a { background-size: 100% 1px; }
  .card__excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: #4f5252;
  }
  .card__more { width: fit-content; color: var(--bronze-ink); }
  .card:hover .card__more { background-size: 100% 1px; }

  .card--feature .card__title { font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.4rem); font-weight: 300; }
  @media (min-width: 992px) {
    .card--feature { grid-template-columns: 1.35fr 1fr; gap: 3.5rem; align-items: center; }
    .card--feature .card__media { aspect-ratio: 4 / 3; }
  }

  .card--compact { grid-template-columns: 96px minmax(0, 1fr); gap: 1.1rem; align-items: center; }
  .card--compact .card__media { aspect-ratio: 1; border-radius: var(--radius); }
  .card--compact .card__title { font-size: 1rem; font-weight: 500; }
  .card--compact .card__body { gap: 0.4rem; }
</style>
