---
import Icon from '../Icon.astro';
---

<section class="nf section section--ink">
    <div class="container nf__inner">
      <p class="eyebrow">Error 404</p>
      <h1 class="h-display">This door is <em>locked.</em></h1>
      <p class="lead">The page you were looking for has moved or no longer exists. Let us take you back to NeoVista.</p>
      <div class="nf__actions">
        <a href="/" class="btn">Back to home <Icon name="arrow-right" /></a>
        <a href="/#contact-sec" class="btn btn--ghost">Contact us</a>
      </div>
    </div>
  </section>

<style>
  .nf { min-height: 100svh; display: grid; align-items: center; padding-top: calc(var(--header-h) + 4rem); }
  .nf__inner { display: grid; gap: 1.75rem; justify-items: start; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; }
</style>
