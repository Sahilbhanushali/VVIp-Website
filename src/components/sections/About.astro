---
import SplitText from '../SplitText.astro';
import Icon from '../Icon.astro';
import MediaImg from '../MediaImg.astro';
import type { Media } from '../../server/media.ts';
import type { SectionData } from '../../server/sections.ts';

interface Props { data: SectionData<'about'>; media: Map<number, Media>; anchor?: string; isHome?: boolean }
const { data, media, anchor = 'about-sec', isHome = false } = Astro.props;
const img = data.image.media_id ? media.get(data.image.media_id) : null;
const local = (h: string) => (isHome && h.startsWith('/#') ? h.slice(1) : h);
---

<section id={anchor} class="section section--light about" aria-labelledby={`${anchor}-title`}>
  <div class="container">
    <header class="section-head section-head--split">
      <div class="about__title">
        {data.eyebrow && <p class="eyebrow" data-reveal>{data.eyebrow}</p>}
        <SplitText id={`${anchor}-title`} class="h-section" text={data.title} />
      </div>
      {data.lead && <p class="lead" data-reveal style="--d:2">{data.lead}</p>}
    </header>

    <div class="about__compose">
      {img && (
        <figure class="about__figure">
          <div class="frame about__frame" data-reveal="clip" data-parallax style="--parallax:5">
            <MediaImg media={img} alt={data.image.alt || undefined} sizes="(min-width: 1100px) 980px, 100vw" width={1600} style={data.image.position ? `object-position:${data.image.position}` : undefined} />
          </div>
          {(data.caption_left || data.caption_right) && (
            <figcaption class="about__caption">
              <span>{data.caption_left}</span>
              <span>{data.caption_right}</span>
            </figcaption>
          )}
        </figure>
      )}

      {(data.card_title || data.card_paragraphs.length > 0) && (
        <div class="about__card" data-reveal style="--d:2">
          {data.card_title && <p class="about__kicker">{data.card_title}</p>}
          {data.card_paragraphs.filter(Boolean).map((p) => <p>{p}</p>)}
          {data.card_link.label && data.card_link.href && (
            <a href={local(data.card_link.href)} class="link-arrow" data-cta={data.card_link.label}>{data.card_link.label} <Icon name="arrow-right" /></a>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .about__title { display: grid; gap: var(--stack); }
  .about__title :global(h2) { max-width: 14ch; }
  .about__compose { display: grid; }
  .about__frame { aspect-ratio: 4 / 3; border-radius: var(--radius-lg); }
  .about__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    font-family: var(--ff-title);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--body-color);
  }
  .about__card {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin: -3rem 0.75rem 0;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    background: var(--ink);
    color: var(--on-dark-muted);
    border-radius: var(--radius-lg);
    box-shadow: 0 40px 80px -40px rgba(13, 13, 12, 0.6);
  }
  .about__kicker {
    font-family: var(--ff-title);
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.55rem);
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--white);
  }
  @media (min-width: 768px) {
    .about__frame { aspect-ratio: 16 / 9; }
  }
  @media (min-width: 1100px) {
    .about__compose { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: end; }
    .about__figure { grid-column: 1 / 10; grid-row: 1; }
    .about__frame { aspect-ratio: 16 / 10; }
    .about__card { grid-column: 8 / 13; grid-row: 1; margin: 0 0 4.5rem; }
  }
</style>
