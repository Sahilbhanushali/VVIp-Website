---
/** Location & connectivity. */
import SplitText from '../SplitText.astro';
import Icon from '../Icon.astro';
import type { SectionData } from '../../server/sections.ts';
import type { Settings } from '../../server/settings.ts';

interface Props { data: SectionData<'location'>; settings: Settings; address?: string | null; anchor?: string }
const { data, settings, address, anchor = 'location' } = Astro.props;
const c = settings.contact;
---

<section id={anchor} class="section section--dark location" aria-labelledby={`${anchor}-title`}>
  <div class="container">
    <header class="section-head section-head--split">
      <div class="section-head__title">
        {data.eyebrow && <p class="eyebrow" data-reveal>{data.eyebrow}</p>}
        <SplitText id={`${anchor}-title`} class="h-section" text={data.title} />
      </div>
      <div class="location__addr" data-reveal style="--d:2">
        <p class="lead">{address || c.address}</p>
        {c.maps_url && <a class="link-arrow" href={c.maps_url} target="_blank" rel="noopener noreferrer" data-track="directions_click">Get directions <Icon name="external" size={14} /></a>}
      </div>
    </header>

    <div class="location__grid">
      <ol class="location__list" role="list">
        {data.items.map((item, i) => (
          <li data-reveal style={`--d:${i}`}>
            <span class="location__no">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              {item.text && <p>{item.text}</p>}
            </div>
          </li>
        ))}
      </ol>
      {data.show_map && c.map_embed && (
        <div class="location__map" data-reveal>
          <iframe title="Map showing our location" src={c.map_embed} width="800" height="600" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .location__addr { display: grid; gap: 1rem; justify-items: start; }
  .location__addr .lead { color: var(--on-dark); }
  .location__grid { display: grid; gap: var(--grid-gap); }
  @media (min-width: 992px) { .location__grid { grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 4rem); } }
  .location__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 0 2rem; align-content: start; }
  .location__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line-dark);
  }
  .location__no { font-family: var(--ff-title); font-size: 0.75rem; font-weight: 600; color: var(--bronze); letter-spacing: 0.1em; padding-top: 0.2rem; }
  .location__list h3 { font-size: 1.05rem; font-weight: 500; margin-bottom: 0.35rem; }
  .location__list p { font-size: 0.9rem; line-height: 1.65; }
  .location__map { min-height: 340px; border-radius: var(--radius-lg); overflow: hidden; background: var(--charcoal-2); }
  .location__map iframe {
    width: 100%;
    height: 100%;
    min-height: 340px;
    border: 0;
    filter: grayscale(0.85) contrast(1.05) brightness(0.92);
    transition: filter 800ms ease;
  }
  .location__map iframe:hover, .location__map iframe:focus { filter: none; }
</style>
