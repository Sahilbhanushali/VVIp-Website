---
/** FAQ accordion on <details>/<summary>; JS adds a smooth height animation. */
import SplitText from '../SplitText.astro';
import Icon from '../Icon.astro';
import type { SectionData } from '../../server/sections.ts';
import type { Settings } from '../../server/settings.ts';

interface Props { data: SectionData<'faq'>; settings: Settings; anchor?: string }
const { data, settings, anchor = 'faq' } = Astro.props;
const id = anchor;
const phone = settings.contact.phones[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

{data.items.length > 0 && (
<section id={id} class="section section--paper faq" aria-labelledby={`${id}-title`}>
  <div class="container faq__grid">
    <div class="faq__intro">
      {data.eyebrow && <p class="eyebrow" data-reveal>{data.eyebrow}</p>}
      <SplitText id={`${id}-title`} class="h-section" text={data.title} />
      {data.lead && <p class="lead" data-reveal style="--d:2">{data.lead}</p>}
      {phone && <a href={phone.href} class="link-arrow" data-reveal style="--d:3"><Icon name="phone" size={16} /> {phone.label}</a>}
    </div>
    <div class="faq__list" data-faq>
      {data.items.map((f, i) => (
        <details class="faq__item" data-reveal style={`--d:${i}`} open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>
)}

<style>
  .faq__grid { display: grid; gap: var(--section-head-gap); }
  @media (min-width: 992px) {
    .faq__grid { grid-template-columns: 0.8fr 1.2fr; gap: clamp(3rem, 6vw, 6rem); align-items: start; }
    .faq__intro { position: sticky; top: calc(var(--header-h) + 2rem); }
  }
  .faq__intro { display: grid; gap: var(--stack); justify-items: start; }
  .faq__list { border-top: 1px solid rgba(13, 13, 12, 0.12); }
  .faq__item { border-bottom: 1px solid rgba(13, 13, 12, 0.12); }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--ff-title);
    font-size: clamp(1.02rem, 0.95rem + 0.4vw, 1.25rem);
    font-weight: 500;
    color: var(--ink);
    transition: color 300ms ease;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover { color: var(--bronze-ink); }
  .faq__icon {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(13, 13, 12, 0.15);
    transition: background-color 400ms ease, border-color 400ms ease, transform 500ms var(--ease-out);
  }
  .faq__icon::before, .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 500ms var(--ease-out);
  }
  .faq__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq__item[open] .faq__icon { background: var(--ink); border-color: var(--ink); color: var(--white); transform: rotate(180deg); }
  .faq__item[open] .faq__icon::after { transform: translate(-50%, -50%) rotate(0); }
  .faq__answer { overflow: hidden; }
  .faq__answer p { padding: 0 3.5rem 1.5rem 0; color: #4f5252; }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLDetailsElement>('[data-faq] details').forEach((details) => {
    const summary = details.querySelector('summary')!;
    const answer = details.querySelector<HTMLElement>('.faq__answer')!;
    let anim: Animation | null = null;
    summary.addEventListener('click', (e) => {
      if (reduced) return;
      e.preventDefault();
      anim?.cancel();
      if (details.open) {
        anim = answer.animate([{ height: `${answer.offsetHeight}px` }, { height: '0px' }], { duration: 400, easing: 'cubic-bezier(0.65, 0, 0.35, 1)' });
        anim.onfinish = () => { details.open = false; };
      } else {
        details.open = true;
        const h = answer.offsetHeight;
        anim = answer.animate([{ height: '0px', opacity: 0 }, { height: `${h}px`, opacity: 1 }], { duration: 500, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' });
      }
    });
  });
</script>
