---
/**
 * Inline SVG icon set — replaces three icon-font stylesheets (≈ 1 MB of
 * Font Awesome) from the original site with a handful of 1-line paths.
 */
export type IconName =
  | 'arrow-right' | 'arrow-left' | 'arrow-up' | 'arrow-down' | 'close' | 'phone' | 'mail' | 'pin'
  | 'clock' | 'send' | 'facebook' | 'instagram' | 'linkedin' | 'external' | 'youtube' | 'x' | 'whatsapp';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 20, class: className, label } = Astro.props;

const stroke: Record<string, string> = {
