---
import { Image } from 'astro:assets';
import logo from '../assets/images/brand/say-yes-logo.png';

interface Props {
  height?: number;
  class?: string;
  eager?: boolean;
}
const { height = 44, class: className, eager = false } = Astro.props;
const width = Math.round((logo.width / logo.height) * height);
---

<Image
  src={logo}
  alt="VVIP — Say Yes"
  width={width}
  height={height}
  densities={[1, 2]}
  format="webp"
  quality={90}
  class={className}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
/>
