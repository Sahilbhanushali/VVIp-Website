---
import type { Media } from '../server/media.ts';
import { mediaUrl, pickVariant } from '../server/media.ts';

interface Props {
  media: Media | null;
  height?: number;
  class?: string;
  eager?: boolean;
  alt?: string;
}
const { media, height = 44, class: className, eager = false, alt = 'VVIP — Say Yes' } = Astro.props;
const ratio = media?.width && media?.height ? media.width / media.height : 3;
const width = Math.round(ratio * height);
const one = media ? pickVariant(media, width) : null;
const two = media ? pickVariant(media, width * 2) : null;
---

{media && one ? (
  <img
    src={mediaUrl(media, one.file)}
    srcset={two && two.file !== one.file ? `${mediaUrl(media, one.file)} 1x, ${mediaUrl(media, two.file)} 2x` : undefined}
    alt={alt}
    width={width}
    height={height}
    class={className}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
) : (
  <span class={className} style="font-family:var(--ff-title);font-weight:600;letter-spacing:.2em;color:var(--bronze)">VVIP</span>
)}
