---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Campaign from '../components/home/Campaign.astro';
import About from '../components/home/About.astro';
import Towers from '../components/home/Towers.astro';
import Signature from '../components/home/Signature.astro';
import Amenities from '../components/home/Amenities.astro';
import Symbol from '../components/home/Symbol.astro';
import Insights from '../components/home/Insights.astro';
import Contact from '../components/home/Contact.astro';
import Gallery from '../components/Gallery.astro';
import { site } from '../data/site';

// Structured data carried over from the original site.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'VVIP Commercial Properties | NeoVista Business Towers',
    description:
      'Premium luxury office spaces, retail showrooms, and healthcare facilities in Vapi, Gujarat. VVIP offers state of the art commercial properties with valet parking, art gallery foyers, and VIP amenities.',
    image: [`${site.url}/og-image.jpg`],
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'NeoVista, Nr. Forest Ply & Hardware, Silvassa Vapi Rd, Char Rasta',
      addressLocality: 'Vapi',
      addressRegion: 'Gujarat',
      postalCode: '396191',
      addressCountry: 'IN',
    },
    geo: { '@type': 'GeoCoordinates', latitude: 20.3687889, longitude: 72.9167278 },
    telephone: ['+919687664422', '+919687664411', '+919687664433'],
    email: ['mail@vapisvip.com', 'odhavdevelopersgroup@gmail.com'],
    url: site.url,
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '18:00',
      },
      { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '10:00', closes: '16:00' },
    ],
    priceRange: '$$$',
    amenityFeature: ['Valet Parking', 'Art Gallery Foyer', 'Double-Height Ceilings', '24/7 Security'].map((name) => ({
      '@type': 'LocationFeatureSpecification',
      name,
      value: true,
    })),
    sameAs: [
      'https://www.facebook.com/profile.php?id=61576362355214',
      'https://www.instagram.com/vapis_vip',
      'https://www.linkedin.com/company/odhav-developers-groups/',
    ],
    aggregateRating: { '@type': 'AggregateRating', ratingValue: 4.8, reviewCount: 47, bestRating: 5 },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      ['Home', '/'],
      ['About NeoVista', '/#about-sec'],
      ['Properties', '/#property-sec'],
      ['Blogs', '/#blog-sec'],
      ['Contact', '/#contact-sec'],
    ].map(([name, path], i) => ({ '@type': 'ListItem', position: i + 1, name, item: `${site.url}${path}` })),
  },
];
---

<BaseLayout
  title="NeoVista Vapi | Luxury Commercial Property & Business Towers in Gujarat"
  description="Discover NeoVista, Vapi's premier luxury commercial property by Odhav Developers. Elite offices, retail showrooms, and hospitality spaces in the heart of Vapi, Gujarat."
  keywords="NeoVista Vapi, luxury commercial property Vapi, office spaces Vapi, retail showrooms Vapi, healthcare hub Vapi, Odhav Developers Vapi, best real estate Vapi, commercial real estate Gujarat, NeoVista business towers, VVIP properties Vapi, Vapi business center, healthcare tower Vapi, premium retail spaces Vapi, NeoVista luxury offices, commercial property in Vapi, business properties Gujarat"
  ogTitle="NeoVista Vapi - Luxury Commercial Property in Gujarat"
  ogDescription="Premium office spaces, retail showrooms & healthcare facilities in Vapi's most prestigious commercial towers"
  path="/"
  isHome
  jsonLd={jsonLd}
>
  <Hero />
  <Campaign />
  <About />
  <Signature />
  <Towers />
  <Gallery />
  <Amenities />
  <Symbol />
  <Insights />
  <Contact />
</BaseLayout>
