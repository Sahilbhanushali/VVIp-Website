---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { all } from '../../../server/db.ts';
import { formatDate } from '../../../server/format.ts';

export const prerender = false;
const me = Astro.locals.user!;
const sessions = await all('SELECT id, user_agent, created_at, last_seen_at FROM admin_sessions WHERE user_id = ? AND expires_at > UTC_TIMESTAMP() ORDER BY last_seen_at DESC', [me.id]);
const perms = [...me.permissions].sort();
---

<AdminLayout title="Account" crumbs={[{ label: 'Account' }]}>
  <div class="a-head"><div><h1>Your account</h1><p>{me.email} · {me.role_name}</p></div></div>
  <div class="grid-2">
    <form class="card" data-profile novalidate>
      <div class="card__head"><h2>Profile</h2></div>
      <div class="card__body stack"><div class="field"><label>Name</label><input class="input" name="name" value={me.name} required maxlength="120" /></div></div>
      <div class="card__foot"><button class="btn btn--primary">Save</button></div>
    </form>
    <form class="card" data-password novalidate>
      <div class="card__head"><div><h2>Change password</h2><p>Other devices are signed out afterwards.</p></div></div>
      <div class="card__body stack">
        <div class="field" data-path="current"><label>Current password</label><input class="input" type="password" name="current" autocomplete="current-password" required /><p class="field__error" data-error></p></div>
        <div class="field" data-path="password"><label>New password</label><input class="input" type="password" name="password" autocomplete="new-password" required minlength="12" /><small>12+ characters, upper- and lower-case letters and a number.</small><p class="field__error" data-error></p></div>
        <div class="field"><label>Repeat new password</label><input class="input" type="password" name="confirm" autocomplete="new-password" required /></div>
      </div>
      <div class="card__foot"><button class="btn btn--primary">Update password</button></div>
    </form>
    <div class="card"><div class="card__head"><h2>Active sessions</h2></div>
      <ul class="list">{sessions.map((s: any) => <li><span>{s.id === me.sessionId ? <strong>This browser</strong> : (s.user_agent ?? 'Unknown').slice(0, 60)}<br /><small>Signed in {formatDate(s.created_at, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}</small></span><small>Active {formatDate(s.last_seen_at, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}</small></li>)}</ul>
    </div>
    <div class="card"><div class="card__head"><h2>Your permissions</h2></div><div class="card__body chips">{perms.map((p) => <span class="badge badge--plain">{p}</span>)}</div></div>
  </div>
  <script>
    import { api, toast } from '../../../scripts/admin/shell';
    import { showErrors } from '../../../scripts/admin/form-builder';
    document.querySelector<HTMLFormElement>('[data-profile]')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      try { await api('/api/admin/auth/password', { method: 'POST', json: { current: '', password: '', name: (f.elements.namedItem('name') as HTMLInputElement).value } }); toast('Saved'); setTimeout(() => location.reload(), 400); } catch (er) { toast((er as Error).message, 'err'); }
    });
    document.querySelector<HTMLFormElement>('[data-password]')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      const d = Object.fromEntries(new FormData(f)) as Record<string, string>;
      if (d.password !== d.confirm) { toast('Passwords do not match', 'err'); return; }
      try { await api('/api/admin/auth/password', { method: 'POST', json: d }); toast('Password updated'); f.reset(); showErrors(f, undefined); }
      catch (er) { showErrors(f, (er as { fields?: Record<string, string> }).fields); toast((er as Error).message, 'err'); }
    });
  </script>
</AdminLayout>
