---
import AuthLayout from '../../layouts/AuthLayout.astro';
export const prerender = false;
const token = Astro.url.searchParams.get('token') ?? '';
---

<AuthLayout title="Choose a new password">
  <div>
    <h1>Choose a new password</h1>
    <p>At least 12 characters with upper- and lower-case letters and a number.</p>
  </div>
  <form class="stack" data-auth-form="/api/admin/auth/reset" data-redirect="/admin/login?reset=1" novalidate>
    <input type="hidden" name="token" value={token} />
    <div class="field">
      <label for="password">New password</label>
      <input class="input" id="password" name="password" type="password" autocomplete="new-password" required minlength="12" autofocus />
    </div>
    <div class="field">
      <label for="confirm">Repeat password</label>
      <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" required minlength="12" />
    </div>
    <p class="field__error" role="alert" data-error></p>
    <button class="btn btn--primary" type="submit">Save password</button>
  </form>
</AuthLayout>
