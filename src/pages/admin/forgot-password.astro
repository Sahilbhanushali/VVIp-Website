---
import AuthLayout from '../../layouts/AuthLayout.astro';
export const prerender = false;
---

<AuthLayout title="Reset password">
  <div>
    <h1>Reset your password</h1>
    <p>Enter your account email. If it exists, we’ll send a reset link that is valid for 30 minutes.</p>
  </div>
  <form class="stack" data-auth-form="/api/admin/auth/forgot" data-success="If that account exists, a reset link has been emailed." novalidate>
    <div class="field">
      <label for="email">Email</label>
      <input class="input" id="email" name="email" type="email" autocomplete="username" required autofocus />
    </div>
    <p class="field__error" role="alert" data-error></p>
    <div class="alert alert--ok" hidden data-success-box></div>
    <button class="btn btn--primary" type="submit">Send reset link</button>
    <a href="/admin/login" class="muted" style="text-align:center">Back to sign in</a>
  </form>
</AuthLayout>
