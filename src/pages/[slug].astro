---
/**
 * Blog article template. Each Markdown file in src/content/blog becomes
 * `/<file-name>.html`, preserving the original URLs:
 *   /blog-details.html, /blog-details-2.html, /blog-details-3.html
 */
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import Icon from '../components/Icon.astro';
import { getPosts, readingTime, formatDate } from '../utils/blog';
import { site } from '../data/site';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}) satisfies GetStaticPaths;

const { post, posts } = Astro.props;
const { Content } = await render(post);
const path = `/${post.id}.html`;
const related = posts.filter((p) => p.id !== post.id);
const minutes = readingTime(post.body ?? '');

const og = await getImage({ src: post.data.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString().slice(0, 10),
    image: new URL(og.src, site.url).href,
    author: { '@type': 'Organization', name: site.name, url: site.url },
    publisher: {
      '@type': 'Organization',
      name: site.name,
      logo: { '@type': 'ImageObject', url: `${site.url}/assets/img/favicons/android-chrome-512x512.png` },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `${site.url}${path}` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blogs', item: `${site.url}/#blog-sec` },
      { '@type': 'ListItem', position: 3, name: post.data.cardTitle, item: `${site.url}${path}` },
    ],
  },
];
---

<BaseLayout
  title={post.data.seoTitle}
  description={post.data.description}
  keywords={post.data.keywords}
  path={path}
  ogType="article"
  ogImage={og.src}
  jsonLd={jsonLd}
>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <article class="article">
    <header class="article__hero">
      <div class="article__hero-media" data-reveal="zoom">
        <Image
          src={post.data.cover}
          format="webp"
          widths={[640, 960, 1280, 1920, 2560]}
          sizes="100vw"
          quality={68}
          alt={post.data.coverAlt}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="article__hero-shade" aria-hidden="true"></div>
      <div class="container article__hero-content">
        <nav aria-label="Breadcrumb" class="breadcrumb">
          <ol role="list">
            <li><a href="/">Home</a></li>
            <li><a href="/#blog-sec">Blogs</a></li>
            <li aria-current="page">Article</li>
          </ol>
        </nav>
        <h1 class="article__title">{post.data.title}</h1>
        <p class="article__meta">
          <span>By {site.name}</span>
          <span aria-hidden="true">·</span>
          <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatDate(post.data.pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </p>
      </div>
    </header>

    <div class="article__wrap section--light">
      <div class="container article__grid">
        <div class="article__body">
          <div class="prose" data-article>
            <Content />
          </div>

          <aside class="article__cta" aria-label="Schedule a site visit">
            <p class="eyebrow">Ready to Invest?</p>
            <p class="article__cta-title">Explore Vapi’s premier commercial address in person.</p>
            <p>
              Connect with our commercial property experts to explore opportunities in Vapi's growing market — and
              schedule a site visit at NeoVista Business Towers.
            </p>
            <div class="article__cta-actions">
              <a href="/#contact-sec" class="btn" data-open-visit>Schedule a visit <Icon name="arrow-right" /></a>
              <a href={site.phones[0].href} class="link-arrow"><Icon name="phone" size={16} /> {site.phones[0].label}</a>
            </div>
          </aside>
        </div>

        <aside class="article__sidebar" aria-label="About and related content">
          <div class="widget">
            <h2 class="widget__title">About Odhav Developers</h2>
            <p>Vapi's premier commercial property developer since 1999, specializing in:</p>
            <ul role="list" class="widget__list">
              <li>Luxury office spaces</li>
              <li>Retail showrooms</li>
              <li>Healthcare facilities</li>
            </ul>
          </div>
          <div class="widget">
            <h2 class="widget__title">Explore More</h2>
            <div class="widget__posts">
              {related.map((p) => <BlogCard post={p} variant="compact" />)}
            </div>
          </div>
          <div class="widget widget--dark">
            <h2 class="widget__title">Contact Our Vapi Office</h2>
            <ul role="list" class="widget__contact">
              {site.phones.map((p) => (
                <li><Icon name="phone" size={16} /><a href={p.href}>{p.label}</a></li>
              ))}
              <li><Icon name="mail" size={16} /><a href={site.emails[0].href}>{site.emails[0].label}</a></li>
              <li><Icon name="pin" size={16} /><span>{site.address}</span></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <section class="section section--paper more" aria-labelledby="more-title">
    <div class="container">
      <header class="more__head">
        <p class="eyebrow">Keep reading</p>
        <h2 id="more-title" class="h-section">More from the <em>blog</em></h2>
      </header>
      <div class="more__grid">
        {related.map((p, i) => <BlogCard post={p} delay={i} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 2px;
    pointer-events: none;
  }
  .reading-progress span {
    display: block;
    height: 100%;
    background: var(--bronze-gradient);
    transform-origin: left;
    transform: scaleX(var(--progress, 0));
  }

  .article__hero {
    position: relative;
    min-height: clamp(540px, 82svh, 860px);
    display: grid;
    align-items: end;
    color: var(--white);
    overflow: hidden;
    isolation: isolate;
    background: var(--ink);
  }
  .article__hero-media, .article__hero-shade { position: absolute; inset: 0; z-index: -1; }
  .article__hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .article__hero-shade {
    background: linear-gradient(180deg, rgba(13, 13, 12, 0.6) 0%, rgba(13, 13, 12, 0.25) 35%, rgba(13, 13, 12, 0.92) 100%);
  }
  .article__hero-content {
    display: grid;
    gap: 1.5rem;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .breadcrumb ol { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .breadcrumb li {
    font-family: var(--ff-title);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }
  .breadcrumb li + li::before { content: '/'; margin-right: 0.5rem; color: var(--bronze); }
  .breadcrumb a:hover { color: var(--white); }
  .breadcrumb [aria-current] { color: var(--bronze-light); }
  .article__title {
    max-width: 22ch;
    overflow-wrap: break-word;
    font-size: clamp(2.1rem, 1.3rem + 3.4vw, 4.6rem);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.04;
    color: var(--white);
  }
  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .article__wrap { background: var(--white); padding-block: clamp(3.5rem, 2.5rem + 4vw, 7rem); }
  .article__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4rem; }
  @media (min-width: 1100px) {
    .article__grid { grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(4rem, 7vw, 8rem); }
  }
  .article__body { max-width: 74ch; }

  .article__cta {
    display: grid;
    gap: 1rem;
    margin-top: 4rem;
    padding: clamp(1.75rem, 1.25rem + 2vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--charcoal);
    color: var(--on-dark-muted);
    position: relative;
    overflow: hidden;
  }
  .article__cta::after {
    content: '';
    position: absolute;
    right: -30%;
    top: -60%;
    width: 80%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(191, 120, 64, 0.22), transparent);
    pointer-events: none;
  }
  .article__cta-title {
    font-family: var(--ff-title);
    font-size: clamp(1.4rem, 1.15rem + 1vw, 2rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--white);
    max-width: 22ch;
  }
  .article__cta-actions { position: relative; z-index: 1; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 0.5rem; }

  .article__sidebar { display: grid; gap: 1.5rem; align-content: start; }
  @media (min-width: 1100px) {
    .article__sidebar { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  }
  .widget {
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    display: grid;
    gap: 1rem;
    font-size: 0.95rem;
  }
  .widget__title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .widget__list { display: grid; gap: 0.5rem; }
  .widget__list li { display: flex; align-items: center; gap: 0.75rem; color: var(--ink); }
  .widget__list li::before { content: ''; width: 0.9rem; height: 1px; background: var(--bronze); }
  .widget__posts { display: grid; gap: 1.25rem; }
  .widget--dark { background: var(--charcoal); border-color: var(--charcoal); color: var(--on-dark-muted); }
  .widget--dark .widget__title { color: var(--white); }
  .widget__contact { display: grid; gap: 0.85rem; }
  .widget__contact li { display: grid; grid-template-columns: 16px 1fr; gap: 0.75rem; align-items: start; }
  .widget__contact svg { color: var(--bronze); margin-top: 0.35rem; }
  .widget__contact a { color: var(--white); overflow-wrap: anywhere; }
  .widget__contact a:hover { color: var(--bronze-light); }

  .more__head { display: grid; gap: 1.25rem; margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .more__grid { display: grid; gap: 3rem 2.5rem; }
  @media (min-width: 768px) { .more__grid { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const article = document.querySelector<HTMLElement>('[data-article]');
  if (bar && article) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = article.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.4 - r.top) / Math.max(1, total)));
      bar.style.setProperty('--progress', p.toFixed(4));
    };
    window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    update();
  }
</script>
