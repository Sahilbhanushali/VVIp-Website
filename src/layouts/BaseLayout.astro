---
import { Font } from 'astro:assets';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import VisitDialog from '../components/VisitDialog.astro';
import IntroLoader from '../components/IntroLoader.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Icon from '../components/Icon.astro';
import type { SiteContext } from '../server/site.ts';

export type Seo = {
  title: string;
  description: string;
  keywords?: string | null;
  canonical?: string | null;
  ogTitle?: string | null;
  ogDescription?: string | null;
  ogImage?: string | null;
  ogType?: 'website' | 'article';
  index?: boolean;
  follow?: boolean;
};

interface Props {
  ctx: SiteContext;
  seo: Seo;
  /** Public path of this page, e.g. `/` or `/blog-details.html`. */
  path: string;
  isHome?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Admin preview: never cached, never tracked, clearly labelled. */
  preview?: boolean;
  /** Property the visit form should be linked to (property pages). */
  propertyId?: number | null;
}

const { ctx, seo, path, isHome = false, jsonLd = [], preview = false, propertyId = null } = Astro.props;
const { settings } = ctx;
const base = settings.seo.canonical_domain.replace(/\/$/, '');
const canonical = seo.canonical || new URL(path, base).href;
const fallbackOg = ctx.ogDefault ? `/media/${ctx.ogDefault.storage_key}/${ctx.ogDefault.variants.find((v) => v.w >= 1200)?.file ?? ctx.ogDefault.variants.at(-1)?.file}` : null;
const ogImageUrl = new URL(seo.ogImage || fallbackOg || '/og-image.jpg', base).href;
const index = settings.seo.allow_indexing && seo.index !== false && !preview;
const robots = `${index ? 'index' : 'noindex'}, ${seo.follow === false ? 'nofollow' : 'follow'}${index ? ', max-image-preview:large, max-snippet:-1, max-video-preview:-1' : ''}`;
const analytics = settings.analytics.enabled && !preview;
const consentRequired = settings.analytics.require_consent || settings.cookie_consent.enabled;
---

<!doctype html>
<html lang="en-IN" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.keywords && <meta name="keywords" content={seo.keywords} />}
    <meta name="author" content={settings.site.name} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" href={canonical} hreflang="en-in" />

    <meta property="og:title" content={seo.ogTitle || seo.title} />
    <meta property="og:description" content={seo.ogDescription || seo.description} />
    <meta property="og:type" content={seo.ogType ?? 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={settings.site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.ogTitle || seo.title} />
    <meta name="twitter:description" content={seo.ogDescription || seo.description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/assets/img/favicons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/assets/img/favicons/site.webmanifest" />
    <meta name="theme-color" content="#0d0d0c" />

    <Font cssVariable="--font-title" preload />
    <Font cssVariable="--font-body" preload={[{ style: 'normal' }]} />

    <script is:inline define:vars={{ isHome, analytics, consentRequired }}>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          if (isHome && !sessionStorage.getItem('vvip-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            d.classList.add('has-intro');
            sessionStorage.setItem('vvip-intro', '1');
          }
        } catch (e) {}
        window.__vvip = { analytics: analytics, consentRequired: consentRequired };
      })();
    </script>

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    {preview && <div class="preview-bar" role="status">Preview — unpublished changes are shown. <a href="/admin">Back to dashboard</a></div>}
    {isHome && <IntroLoader />}
    <SiteHeader isHome={isHome} ctx={ctx} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter isHome={isHome} ctx={ctx} />
    <VisitDialog ctx={ctx} propertyId={propertyId} />
    {analytics && consentRequired && <CookieConsent message={settings.cookie_consent.message} />}

    <button class="scroll-top" type="button" aria-label="Back to top" data-scroll-top>
      <svg class="scroll-top__ring" viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="24" r="22" pathLength="100" />
        <circle cx="24" cy="24" r="22" pathLength="100" data-progress />
      </svg>
      <Icon name="arrow-up" size={18} />
    </button>

    <script>
      import '../scripts/main';
      import '../scripts/track';
    </script>
  </body>
</html>

<style>
  .preview-bar {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    z-index: 300;
    transform: translateX(-50%);
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    background: #fde68a;
    color: #1a1a1a;
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }
  .preview-bar a { text-decoration: underline; margin-left: 0.5rem; }
  .scroll-top {
    position: fixed;
    right: clamp(1rem, 2.5vw, 2rem);
    bottom: clamp(1rem, 2.5vw, 2rem);
    z-index: 40;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(13, 13, 12, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--white);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: opacity 400ms ease, transform 500ms var(--ease-out), visibility 400ms, background-color 300ms ease;
  }
  .scroll-top.is-visible { opacity: 1; visibility: visible; transform: none; }
  .scroll-top:hover { background: var(--bronze); color: var(--ink); }
  .scroll-top__ring { position: absolute; inset: 0; transform: rotate(-90deg); }
  .scroll-top__ring circle { fill: none; stroke-width: 1.5; }
  .scroll-top__ring circle:first-child { stroke: rgba(255, 255, 255, 0.15); }
  .scroll-top__ring circle:last-child {
    stroke: var(--bronze);
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - var(--progress, 0) * 100);
  }
</style>
