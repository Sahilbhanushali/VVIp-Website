<IfModule mod_headers.c>
    # HTML / PHP / JSON: always revalidate so content updates are seen immediately
    <FilesMatch "\.(html|htm|php|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Astro's fingerprinted build assets never change: cache for a year
    <If "%{REQUEST_URI} =~ m#^/_astro/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>

    # Static brand assets (icons, favicons, og image)
    <FilesMatch "\.(svg|png|jpg|jpeg|webp|avif|ico|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /404.html
